/*40000537
00052583
fc058ee3
00160613
ff5ff06f
*/


500002b7  // 1. lui t0, 0x50000        -> 設定 t0 = 0x50000000 (VRAM 基底位址)
00000313  // 2. addi t1, x0, 0         -> 初始化 t1 = 0 (目前寫入的像素計數)
00100393  // 3. addi t2, x0, 1         -> 設定 t2 = 1 (要寫入 VRAM 的顏色：白色)
012c0337  // 4. lui t1, 0x012c0        -> (輔助) 載入高位數準備設定結束界限
00030313  // 5. addi t6, x0, 76800     -> 設定 t6 = 76800 (320*240 總像素點數)
          // <Loop_Start>:
00728023  // 6. sw t2, 0(t0)           -> 將 t2(白色) 寫入目前的 VRAM 位址 [t0]
00428293  // 7. addi t0, t0, 4         -> t0 = t0 + 4 (指標移至下一個 Word 位址)
00130313  // 8. addi t1, t1, 1         -> t1 = t1 + 1 (像素計數加 1)
fe6318e3  // 9. bne t1, t6, -16        -> 如果 t1 != 76800，跳回第 6 行繼續畫
          // <Done>:
0000006f  // 10. jal x0, 0             -> 畫完後原地打轉 (死迴圈)，防止 CPU 亂跑